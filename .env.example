# Threads UI Environment Configuration

# 1. Threads MCP Backend URL (Where your Log MCP backend is running)
# Defaults to http://127.0.0.1:3000 if not specified
THREADS_MCP_URL=http://127.0.0.1:3000

# 2. User ID to scope posts and drafts
# Defaults to chatgpt-user
DEFAULT_USER_ID=chatgpt-user

# 3. Optional Direct Cloud Firestore Fallback
# If the MCP backend server is unreachable, the UI can read directly from Firestore.
# (If running locally next to "Log MCP", these are auto-detected from ../Log MCP/.env)
FIREBASE_PROJECT_ID=threads-log-f1545
FIREBASE_API_KEY=your-firebase-web-api-key
